---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Contact from '@components/Contact.astro';
import Footer from '@components/Footer.astro';

const homeLink = new URL('./', Astro.site).toString();
const navLinks = [
  { title: `Projects`, href: `${homeLink}#projects` },
  { title: `About`, href: `${homeLink}#about` },
  { title: `Main Skills`, href: `${homeLink}#main-skills` },
  { title: `Resources`, href: `${homeLink}resources` },
];
const navLinksHighlighted = [
  { title: `Reach out`, href: `${homeLink}contact` },
];
---

<Layout
  title='Reach out | Catalin Petrovici'
  description={`Full Stack Engineer and Electrical Engineer building cloud platforms and web apps with TypeScript, Node.js, React and AWS. Explore my projects and let's work together.`}
>
  <Header navLinks={navLinks} navLinksHighlighted={navLinksHighlighted} />
  <main id='main-content'>
    <Contact />
    <Footer />
  </main>
</Layout>

<style></style>
