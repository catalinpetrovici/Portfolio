---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Features from '@components/Features.astro';
import Projects from '@components/Projects.astro';
import LogoSection from '@components/LogoSection.astro';
import WorkTogether from '@components/WorkTogether.astro';
import About from '@components/About.astro';
import Footer from '@components/Footer.astro';

const navLinks = [
  { title: 'Projects', href: '#projects' },
  { title: 'About', href: '#about' },
  { title: 'Main Skills', href: '#main-skills' },
  { title: 'Resources', href: '/resources' },
];
const navLinksHighlighted = [{ title: 'Reach out', href: '/contact' }];
---

<Layout
  title="Full Stack Engineer | Catalin Petrovici"
  description={`Full Stack Engineer and Electrical Engineer building cloud platforms and web apps with TypeScript, Node.js, React and AWS. Explore my projects and let's work together.`}
>
  <Header navLinks={navLinks} navLinksHighlighted={navLinksHighlighted} />
  <main id="main-content">
    <Hero />
    <Features />
    <Projects />
    <LogoSection />
    <WorkTogether />
    <About />
    <Footer />
  </main>
</Layout>
