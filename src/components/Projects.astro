---
import PrimeBatteriesLogo from '@svg/projects/PrimeBatteries.astro';
import CaierSpaceLogo from '@svg/projects/CaierSpace.astro';
import HemsLogo from '@svg/projects/Hems.astro';
import SmartHomeLogo from '@svg/projects/SmartHome.astro';
import ReactLogo from '@svg/projects/React.astro';
import NodeJSLogo from '@svg/projects/NodeJS.astro';
import AWSLogo from '@svg/logoSection/AWS.astro';
import ArrowRight from '@svg/Symbols/ArrowRight.astro';

const projects = [
  {
    title: 'Prime Batteries EMS/SCADA Platform',
    subtitle: 'Client Project',
    href: 'https://primebatteries.com',
    description: `A cloud platform for Prime Batteries Technology, a company that builds and installs
    battery energy storage systems (BESS). I owned the full cycle, from architecture and design to
    implementation and administration. TypeScript microservices on Node.js and AWS Lambda collect
    data from battery management systems and inverters over MQTT and AWS IoT Core, storing it in
    DynamoDB, PostgreSQL and InfluxDB. A React dashboard gives the technical team and end customers
    real-time monitoring, remote control and troubleshooting, and the whole infrastructure is
    deployed as code with AWS CDK.`,
    Logo: {
      Svg: PrimeBatteriesLogo,
    },
    image: {},
  },
  {
    title: 'CaierSpace.com',
    subtitle: 'Website',
    href: 'https://caierspace.com',
    description: `I developed a psychology website aimed at showcasing their services, simplifying the process for potential clients to book appointments and contact them. The site uses a calming color scheme, easy navigation, and content that highlights the psychologist's supportive approach to mental health. It integrates current web design trends and technology, ensuring it operates smoothly on both desktop and mobile devices. This makes the website not only user-friendly but also a true representation of the psychologist's unique identity and approach.`,
    Logo: {
      Svg: CaierSpaceLogo,
    },
    image: {
      alt: 'CaierSpace Landing Page Project Showcase',
      scr: './CaierSpace/CaierSpace@1x.png',
      height: '408',
      width: '700',
      source: [
        {
          srcset:
            './CaierSpace/CaierSpace-mobile@2x.avif 2x, ./CaierSpace/CaierSpace-mobile@1x.avif',
          type: 'image/avif',
          media: '(max-width: 500px)',
        },
        {
          srcset:
            './CaierSpace/CaierSpace-mobile@2x.webp 2x, ./CaierSpace/CaierSpace-mobile@1x.webp',
          type: 'image/webp',
          media: '(max-width: 500px)',
        },
        {
          srcset:
            './CaierSpace/CaierSpace-mobile@2x.png 2x, ./CaierSpace/CaierSpace-mobile@1x.png',
          type: 'image/png',
          media: '(max-width: 500px)',
        },
        {
          srcset:
            './CaierSpace/CaierSpace@2x.avif 2x, ./CaierSpace/CaierSpace@1x.avif',
          type: 'image/avif',
          media: '',
        },
        {
          srcset:
            './CaierSpace/CaierSpace@2x.webp 2x, ./CaierSpace/CaierSpace@1x.webp',
          type: 'image/webp',
          media: '',
        },
        {
          srcset: './CaierSpace/CaierSpace@2x.png 2x',
          type: 'image/png',
          media: '',
        },
      ],
    },
  },
  {
    title: 'Home Energy Management System',
    subtitle: 'Publication',
    href: 'https://ieeexplore.ieee.org/document/9959793',
    description: `I built a practical solution for managing home energy.
    The system lets you remotely control your devices, monitor your power consumption,
    monitor solar production and performance, and even forecast the future behaviour
    of equipment and energy indicators, making it an efficient and effective solution
    for managing energy usage in the home. It's easy to use and integrates open-source
    software for added flexibility.`,
    Logo: {
      Svg: HemsLogo,
    },
    image: {
      alt: 'HEMS Publication Showcase',
      scr: './Hems/Hems@1x.png',
      height: '408',
      width: '700',
      source: [
        {
          srcset: './Hems/Hems-mobile@2x.avif 2x, ./Hems/Hems-mobile@1x.avif',
          type: 'image/avif',
          media: '(max-width: 500px)',
        },
        {
          srcset: './Hems/Hems-mobile@2x.webp 2x, ./Hems/Hems-mobile@1x.webp',
          type: 'image/webp',
          media: '(max-width: 500px)',
        },
        {
          srcset: './Hems/Hems-mobile@2x.png 2x, ./Hems/Hems-mobile@1x.png',
          type: 'image/png',
          media: '(max-width: 500px)',
        },
        {
          srcset: './Hems/Hems@2x.avif 2x, ./Hems/Hems@1x.avif',
          type: 'image/avif',
          media: '',
        },
        {
          srcset: './Hems/Hems@2x.webp 2x, ./Hems/Hems@1x.webp',
          type: 'image/webp',
          media: '',
        },
        {
          srcset: './Hems/Hems@2x.png 2x',
          type: 'image/png',
          media: '',
        },
      ],
    },
  },
  {
    title: 'Smart Home, Raspberry Pi, Microcontrollers, MQTT',
    subtitle: 'Bachelor Degree',
    href: 'https://www.youtube.com/watch?v=MpF0Z2glEeM',
    description: `For my bachelor's degree I built a smart home system from the ground up.
    Microcontrollers spread around the house read sensors and switch devices, and they
    talk to a Raspberry Pi hub over MQTT, a lightweight messaging protocol made for IoT.
    A web dashboard shows live readings and lets you control everything from your phone
    or computer. The project taught me how hardware, networking and software fit together
    in a real, working system.`,
    Logo: {
      Svg: SmartHomeLogo,
    },
    image: {
      alt: 'SmartHome Project Showcase',
      scr: './SmartHome/SmartHome@1x.png',
      height: '408',
      width: '700',
      source: [
        {
          srcset:
            './SmartHome/SmartHome-mobile@2x.avif 2x, ./SmartHome/SmartHome-mobile@1x.avif',
          type: 'image/avif',
          media: '(max-width: 500px)',
        },
        {
          srcset:
            './SmartHome/SmartHome-mobile@2x.webp 2x, ./SmartHome/SmartHome-mobile@1x.webp',
          type: 'image/webp',
          media: '(max-width: 500px)',
        },
        {
          srcset:
            './SmartHome/SmartHome-mobile@2x.png 2x, ./SmartHome/SmartHome-mobile@1x.png',
          type: 'image/png',
          media: '(max-width: 500px)',
        },
        {
          srcset:
            './SmartHome/SmartHome@2x.avif 2x, ./SmartHome/SmartHome@1x.avif',
          type: 'image/avif',
          media: '',
        },
        {
          srcset:
            './SmartHome/SmartHome@2x.webp 2x, ./SmartHome/SmartHome@1x.webp',
          type: 'image/webp',
          media: '',
        },
        {
          srcset: './SmartHome/SmartHome@2x.png 2x',
          type: 'image/png',
          media: '',
        },
      ],
    },
  },
  {
    title: 'Home Dashboard',
    subtitle: 'Full Stack App',
    href: 'https://github.com/catalinpetrovici/Home_Dashboard',
    description: `A self-hosted dashboard for the home. Users can sign up, log in and manage
    their data through a React and TypeScript frontend. The Node.js and TypeScript backend
    stores data in PostgreSQL and Redis, and collects data from devices over MQTT,
    so the dashboard can show what is happening around the house.`,
    Logo: {
      Svg: NodeJSLogo,
    },
    image: {},
  },
  {
    title: 'Summarizer',
    subtitle: 'Browser Extension',
    href: 'https://github.com/catalinpetrovici/summarizer',
    description: `A browser extension that summarizes the page you are reading with AI
    (Deepseek or OpenAI). Built with React, TypeScript and Vite on Manifest V3, with a
    clean popup UI and summaries rendered as Markdown. It saves time on long articles
    and documentation by giving you the key points in seconds.`,
    Logo: {
      Svg: ReactLogo,
    },
    image: {},
  },
  {
    title: 'LambdaRouterFlow',
    subtitle: 'Open Source Library',
    href: 'https://github.com/catalinpetrovici/lambda-router-flow',
    description: `A lightweight router for AWS Lambda, published on npm. It lets you define
    routes like get('/roles') or patch('/roles/{roleId+}') inside a single Lambda function,
    with middleware for checks such as permissions and built-in error handling. It keeps
    serverless APIs small and readable without pulling in a full web framework.`,
    Logo: {
      Svg: AWSLogo,
    },
    image: {},
  },
];
---

<section id="projects" class="mt-28">
  <h2>Projects</h2>
  {
    projects.map((item) => {
      const { title, subtitle, href, description, Logo, image } = item;
      return (
        <article class="project">
          <div class="description">
            <div class="project-heading">
              <Logo.Svg />
              <div class="ml-8">
                <span class="subtitle text-fontLightGray2 dark:text-fontDarkGray4">
                  {subtitle}
                </span>
                <h3>{title}</h3>
              </div>
            </div>
            <p class="text-fontLightGray2 dark:text-fontDarkGray3">
              {description}
            </p>
            <a href={href} class="hover:text-btnLight dark:hover:text-btnDark">
              <ArrowRight />
              View Project
            </a>
          </div>
          {Object.keys(image).length !== 0 ? (
            <picture slot="image-showcase">
              {image.source.map((imageItem) => {
                if (!imageItem) return;

                if (imageItem.media.length < 1) {
                  return (
                    <source srcset={imageItem.srcset} type={imageItem.type} />
                  );
                }

                return (
                  <source
                    srcset={imageItem.srcset}
                    media={imageItem.media}
                    type={imageItem.type}
                  />
                );
              })}
              <img
                width={image.width}
                height={image.height}
                src={image.scr}
                alt={image.alt}
                loading="lazy"
              />
            </picture>
          ) : (
            ''
          )}
        </article>
      );
    })
  }
</section>

<style>
  img {
    width: 100%;
    max-width: 70rem;
  }

  .logo {
    max-width: 5rem;
    max-height: 5rem;
  }

  .project {
    margin-top: 4rem;
  }

  h3 {
    font-size: clamp(2rem, 4vw, 2.4rem);
    font-weight: 600;
  }

  .project-heading {
    display: flex;
    align-items: flex-end;
  }

  .subtitle {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
  }

  p {
    max-width: 75ch;
    margin-top: 2rem;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
  }

  a {
    margin-top: 1.8rem;
    margin-bottom: 1.8rem;
    display: flex;
    align-content: center;
    align-items: center;
    font-size: clamp(1.8rem, 2.5vw, 2rem);
    font-weight: 900;
    transition: all 200ms ease-in-out;
  }

  a svg {
    margin-right: 2rem;
  }

  @media only screen and (min-width: 1200px) {
    .project {
      display: flex;
      gap: 5rem;
      margin-top: 10rem;
    }

    .project:nth-child(odd) .description {
      order: 1;
    }
  }
</style>
