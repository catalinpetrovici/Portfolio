---
interface Props {
  class?: string;
  width?: string;
  height?: string;
}
const { class: className, width = '50', height = '50' } = Astro.props;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox='0 0 50 50'
  fill='none'
  stroke='currentColor'
  stroke-width='2.5'
  stroke-linecap='round'
  stroke-linejoin='round'
  xmlns='http://www.w3.org/2000/svg'
>
  <rect x='13' y='9' width='24' height='36' rx='3'></rect>
  <path d='M20 5h10'></path>
  <path d='M27 17l-6 10h8l-6 10'></path>
</svg>
