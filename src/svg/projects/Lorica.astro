---
interface Props {
  class?: string;
  width?: string;
  height?: string;
}
const { class: className, width = '50', height = '50' } = Astro.props;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox='0 0 50 50'
  fill='none'
  stroke='currentColor'
  stroke-width='2.5'
  stroke-linecap='round'
  stroke-linejoin='round'
  xmlns='http://www.w3.org/2000/svg'
>
  <path d='M25 5l16 6v12c0 10-7 18-16 22C16 41 9 33 9 23V11z'></path>
  <circle cx='19' cy='22' r='3'></circle>
  <circle cx='31' cy='22' r='3'></circle>
  <circle cx='25' cy='32' r='3'></circle>
  <path d='M22 22h6M20.5 24.6l3 4.8M29.5 24.6l-3 4.8'></path>
</svg>
